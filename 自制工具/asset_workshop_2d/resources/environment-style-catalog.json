  "rules": [
    {
      "id": "ENV-CHAR-01",
      "version": "1",
      "layer": "L0",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "成熟二次元手绘环境美术；以概括形状、克制块面表达结构，可借鉴赛璐璐组织但不强制所有物件纯两色。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-CHAR-02",
      "version": "1",
      "layer": "L0",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "先读整体与结构，再读材质；安静的大面与必要细节保持主次。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-CHAR-03",
      "version": "1",
      "layer": "L0",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "negative",
      "text": "避免写实抛光和密集精修，也避免塑料般空洞的廉价几何平涂。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-CHAR-04",
      "version": "1",
      "layer": "L0",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "warning",
      "text": "共享表现原则，具体画法随材质与用途变化；不把石砖颜色、裂缝及构图统一施加给全部素材。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-COM-01",
      "version": "1",
      "layer": "L1",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "大形建立整体，中形补结构，小形点缀；约 6:3:1 仅为视觉启发，不是像素面积或形状数量验收公式。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-COM-02",
      "version": "1",
      "layer": "L1",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "普通高亮从主体色体系内稍提亮，必要转折少量提结构，允许整段不画；发光/特殊反射依任务另审。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-COM-03",
      "version": "1",
      "layer": "L1",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "negative",
      "text": "不要整圈偏白亮描边、密集短碎亮线、细锯齿与频繁小起伏；断续不等于碎线更多。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
      "id": "ENV-COM-04",
      "version": "1",
      "layer": "L1",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "背光、闭塞和接触关系用少量深色块概括；近黑处停止精细刻画，保留结构信息。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
    },
    {
