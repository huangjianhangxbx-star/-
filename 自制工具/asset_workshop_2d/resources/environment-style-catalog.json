      "version": "1",
      "layer": "L1",
      "domain": "environment",
      "applicableMaterialFamilies": [
        "all"
      ],
      "ruleType": "positive",
      "text": "材质变化按需保留，允许极弱、整体化色差；结构已经成立时，不为表现材质额外填充纹理。",
      "status": "approved",
      "origin": "2DW-05B M0：用户批准及三项修订，2026-10-10；docs/ENVIRONMENT-STYLE.md",
      "checkMode": "visual-review"
