{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xinghai.local/schemas/spw-ai-mapping-v1.schema.json",
  "title": "SPW AI 映射提案 v1",
  "type": "object",
  "properties": {
    "proposalSchema": {
      "const": "spw.ai.mapping.v1"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "skeletonName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "projectHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fileHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "skeletonFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "skin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "directionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "projectPath",
        "skeletonName",
        "projectHash",
        "fileHash",
        "skeletonFingerprint",
        "skin",
        "directionId"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "skeletonName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "projectHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fileHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "skeletonFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "skin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "directionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "projectPath",
        "skeletonName",
        "projectHash",
        "fileHash",
        "skeletonFingerprint",
        "skin",
        "directionId"
      ],
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "bone",
              "slot",
              "ik",
              "transform",
              "path",
              "physics",
              "attachment",
              "event"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "center",
              "unknown"
            ]
          },
          "drive": {
            "type": "string",
            "enum": [
              "direct",
              "fk-bone",
              "ik-target",
              "transform-control"
            ]
          },
          "semanticRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "proposed",
              "unresolved"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 128,
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reviewNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 32
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 4096,
            "uniqueItems": true,
            "minItems": 1
          },
          "sourceSkin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sourceSlot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "targetSkin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "targetSlot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "kind",
          "source",
          "target",
          "side",
          "drive",
          "semanticRole",
          "status",
          "evidenceIds",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "source",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [
    "proposalSchema",
    "bundleId",
    "source",
    "target",
    "mappings",
    "unresolved"
  ],
  "additionalProperties": false
}
