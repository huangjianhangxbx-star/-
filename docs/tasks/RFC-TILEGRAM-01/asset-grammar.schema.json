{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original asset grammar 0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "templateId",
    "templateVersion",
    "sourceOfMethod",
    "assetKind",
    "cellPixels",
    "unityPixelsPerUnit",
    "canvasPixels",
    "masterPanels",
    "cutRegions",
    "pivot",
    "trimPolicy",
    "alphaPolicy",
    "overhang",
    "sorting",
    "layerRequirements",
    "sharedShapeConstraints",
    "edgeConstraints",
    "generationStages",
    "validationScenes",
    "unsupportedCases",
    "uncertainty"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xh-asset-grammar/1"
    },
    "templateVersion": {
      "type": "string"
    },
    "assetKind": {
      "enum": [
        "random-ground",
        "four-way",
        "eight-way-conditional",
        "wall-frame",
        "overlay",
        "custom"
      ]
    },
    "cellPixels": {
      "type": "integer",
      "minimum": 1
    },
    "unityPixelsPerUnit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cutRegions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pivot": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "masterPanels": {
      "type": "array",
      "minItems": 1
    }
  }
}